new file mode 100644
index 0000000..4bf6bfe
--- /dev/null
+++ b/apps/desktop/src/lib/shell-escape.ts
@@ -0,0 +1,33 @@
+export interface DesktopShellExecResponse {
+  code: number
+  stderr?: string
+  stdout?: string
+  cwd?: string
+}
+
+interface DesktopShellEscapeDeps {
+  requestGateway: (method: string, params: { command: string; session_id: string }) => Promise<DesktopShellExecResponse>
+  appendMessage: (role: 'user' | 'system', text: string) => void
+}
+
+export function shellCommandFromInput(text: string): string | null {
+  if (!text.startsWith('!')) {
+    return null
+  }
+
+  return text.slice(1).trim()
+}
+
+export async function runDesktopShellEscape(
+  command: string,
+  sessionId: string,
+  { requestGateway, appendMessage }: DesktopShellEscapeDeps
+): Promise<void> {
+  appendMessage('user', `!${command}`)
+  const result = await requestGateway('shell.exec', { command, session_id: sessionId })
+  const output = [result.stdout, result.stderr].filter(Boolean).join('\n').trim()
+  const status = result.code !== 0 || !output ? [output, `exit ${result.code}`].filter(Boolean).join('\n') : output
+  const displayCommand = command.replace(/\s+/g, ' ').trim()
+
+  appendMessage('system', `shell:${displayCommand}\n${status}`)
+}
