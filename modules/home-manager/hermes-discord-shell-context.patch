+    blocks = session.pop("pending_shell_context", [])
+    if not blocks:
+        return run_message
+    context = "\n\n".join(str(block) for block in blocks)
+    if isinstance(run_message, str):
+        return f"{context}\n\n{run_message}"
+    if isinstance(run_message, list):
+        return [{"type": "text", "text": context}, *run_message]
+    return run_message
