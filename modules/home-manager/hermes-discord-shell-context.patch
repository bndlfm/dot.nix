+import { describe, expect, it, vi } from 'vitest'
+
+import { runDesktopShellEscape, shellCommandFromInput } from './shell-escape'
+
+describe('shellCommandFromInput', () => {
+  it('recognizes a leading bang as a shell escape', () => {
+    expect(shellCommandFromInput('! ls -la')).toBe('ls -la')
+  })
+
+  it('does not treat an embedded bang as a shell escape', () => {
+    expect(shellCommandFromInput('explain ! ls')).toBeNull()
+  })
+
+  it('returns an empty command for a bare bang so the caller can show usage', () => {
+    expect(shellCommandFromInput('!')).toBe('')
+  })
+})
+
+describe('runDesktopShellEscape', () => {
+  it('executes against the active session and renders the result without invoking the model', async () => {
+    const requestGateway = vi.fn(async () => ({ code: 0, stdout: 'alpha\nbeta\n', stderr: '', cwd: '/work' }))
+    const appendMessage = vi.fn()
+
+    await runDesktopShellEscape('ls', 'ui-session', { requestGateway, appendMessage })
+
+    expect(requestGateway).toHaveBeenCalledWith('shell.exec', {
+      command: 'ls',
+      session_id: 'ui-session'
+    })
+    expect(appendMessage).toHaveBeenNthCalledWith(1, 'user', '!ls')
+    expect(appendMessage).toHaveBeenNthCalledWith(2, 'system', 'shell:ls\nalpha\nbeta')
+  })
+})
