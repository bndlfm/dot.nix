+static uint64_t clock_ms(clockid_t id) {
+	struct timespec ts;
+	if (clock_gettime(id, &ts) < 0) {
+		return 0;
+	}
+	return (uint64_t) ts.tv_sec * 1000 + (uint64_t) ts.tv_nsec / 1000000;
+}
+
+static bool is_before(uint64_t now, uint64_t deadline) {
+	return now < deadline;
+}
